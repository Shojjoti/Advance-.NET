@{
}
<h1>Advance .Net Lab 2</h1>
<br>
<div>
    <h2>Here I am Showing Item details</h2>

    <table class="table">
        <thead>
            <tr>
                <td>ID</td>
                <td>Name</td>
                <td>Description</td>
                <td>Price</td>
                <td>Stock Quantity</td>
                <td>Image</td>
                <td>Action</td>
            </tr>
        </thead>

        <tbody>
            @foreach(var items in Model )
                {
                    <tr>
                        <td> @items.id </td>
                        <td> @items.name </td>
                        <td> @items.description  </td>
                        <td> @items.price </td>
                        <td> @items.stockQuantity </td>
                        <td>Loading </td>

                        <td> 
                            <button class="btn-primary"> Action</button>
                        </td>
                        
                    </tr>

                }
        </tbody>

        
    </table>
</div>

